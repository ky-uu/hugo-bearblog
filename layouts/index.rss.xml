{{- $pages := slice -}}
{{- range .Sites -}}
  {{- range .RegularPages -}}
    {{- $isBlog := false -}}
    
    {{- with .Params.categories -}}
      {{- if reflect.IsSlice . -}}
        {{- $isBlog = in . "blog" -}}
      {{- else if eq . "blog" -}}
        {{- $isBlog = true -}}
      {{- end -}}
    {{- end -}}

    {{- if or $isBlog (eq .Section "blog") -}}
      {{- $pages = $pages | append . -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $pages = sort $pages "Date" "desc" -}}

{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
  {{- $pages = $pages | first $limit -}}
{{- end -}}

{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" 
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.BaseURL }}</link>
    <description>Writing something in some different languages</description>
    {{- with .OutputFormats.Get "rss" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- else }}
    <atom:link href="{{ "rss.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range $pages }}
    <item xml:lang="{{ .Lang }}">
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- range (.GetTerms "tags") }}
      <category>{{ .LinkTitle }}</category>
      {{- end }}
      {{- $content := .Content -}}
      {{- $ytPattern := `<iframe[^>]*src="[^"]*(?:youtube\.com\/(?:embed\/|v\/|watch\?v=)|youtu\.be\/)([\w-]+)[^"]*"[^>]*>.*?</iframe>` -}}
      {{- $ytReplacement := `<p><a href="https://www.youtube.com/watch?v=$1" target="_blank" rel="noopener"><img src="https://img.youtube.com/vi/$1/hqdefault.jpg" alt="Watch Video on YouTube" /></a></p>` -}}
      {{- $content = $content | replaceRE $ytPattern $ytReplacement -}}
      {{- $content = $content | replaceRE `<iframe[^>]*>.*?</iframe>` "" -}}
      {{- $content = $content | replaceRE `\sstyle="[^"]*"` "" -}}
      {{- $base := strings.TrimRight "/" site.BaseURL -}}
      {{- $content = $content | replaceRE `(src|href)=["'](/[^/"'][^"']*)["']` (printf `$1="%s$2"` $base) -}}
      {{- $content = $content | replaceRE `<(img|br|hr)([^>]*?)(?:\s*\/)?>` `<$1$2 />` -}}
      <description>{{ printf "<![CDATA[%s]]>" $content | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>